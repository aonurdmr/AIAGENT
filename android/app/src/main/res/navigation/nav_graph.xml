<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/homeFragment">

    <fragment android:id="@+id/homeFragment"
        android:name="com.dogaai.ui.home.HomeFragment"
        android:label="Ana Sayfa">
        <action android:id="@+id/action_home_to_identify"
            app:destination="@id/identifyFragment" />
        <action android:id="@+id/action_home_to_map"
            app:destination="@id/mapFragment" />
        <action android:id="@+id/action_home_to_chat"
            app:destination="@id/chatFragment" />
        <action android:id="@+id/action_home_to_activity"
            app:destination="@id/activityFragment" />
    </fragment>

    <fragment android:id="@+id/authFragment"
        android:name="com.dogaai.ui.auth.AuthFragment"
        android:label="Giriş">
        <action android:id="@+id/action_auth_to_home"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/authFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment android:id="@+id/identifyFragment"
        android:name="com.dogaai.ui.identify.IdentifyFragment"
        android:label="AI Tanımla">
        <action android:id="@+id/identifyResultFragment"
            app:destination="@id/homeFragment" />
    </fragment>

    <fragment android:id="@+id/mapFragment"
        android:name="com.dogaai.ui.map.MapFragment"
        android:label="Harita" />

    <fragment android:id="@+id/chatFragment"
        android:name="com.dogaai.ui.chat.ChatFragment"
        android:label="AI Asistan" />

    <fragment android:id="@+id/activityFragment"
        android:name="com.dogaai.ui.activity.ActivityFragment"
        android:label="Aktiviteler" />

    <fragment android:id="@+id/communityFragment"
        android:name="com.dogaai.ui.community.CommunityFragment"
        android:label="Topluluk" />

    <fragment android:id="@+id/profileFragment"
        android:name="com.dogaai.ui.profile.ProfileFragment"
        android:label="Profil" />

</navigation>
